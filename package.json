{
  "name": "papertrade-farmer",
  "version": "0.1.0",
  "private": true,
  "description": "Hedged long/short PAPER farming bot for Papertrade",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ptbot": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "viem": "^2.57.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
